{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoa-playbooks/schemas/playbook-registry.schema.json",
  "title": "AoA playbook registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "layer", "artifact_identity", "playbooks"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "layer": {
      "type": "string",
      "const": "aoa-playbooks"
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_class",
        "surface_state",
        "owner_repo",
        "authority_ref",
        "producer",
        "consumer_expectation",
        "privacy_boundary",
        "content_identity",
        "abi_epoch",
        "contract_version",
        "trust_layer",
        "verification"
      ],
      "properties": {
        "artifact_class": {
          "const": "playbook_registry_bundle"
        },
        "surface_state": {
          "const": "public_source_authored_playbook_registry"
        },
        "owner_repo": {
          "const": "aoa-playbooks"
        },
        "authority_ref": {
          "const": "README.md#current-public-surfaces"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "consumer_expectation": {
          "type": "string",
          "minLength": 1
        },
        "privacy_boundary": {
          "type": "string",
          "minLength": 1
        },
        "content_identity": {
          "type": "string",
          "minLength": 1
        },
        "abi_epoch": {
          "const": "aoa_playbooks_registry_bundle_v1"
        },
        "contract_version": {
          "const": "schemas/playbook-registry.schema.json@aoa_playbooks_registry_bundle_v1#artifact_identity"
        },
        "trust_layer": {
          "type": "array",
          "prefixItems": [
            {
              "const": "abi_contract_signature"
            },
            {
              "const": "slsa_in_toto"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3
        }
      }
    },
    "playbooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "summary",
          "scenario",
          "trigger",
          "prerequisites",
          "participating_agents",
          "required_skill_families",
          "evaluation_posture",
          "memory_posture",
          "fallback_mode",
          "expected_artifacts"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "name": {"type": "string", "minLength": 3},
          "status": {"type": "string", "enum": ["active", "planned", "experimental", "deprecated"]},
          "summary": {"type": "string", "minLength": 10},
          "scenario": {"type": "string", "minLength": 3},
          "trigger": {"type": "string", "minLength": 3},
          "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "participating_agents": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "required_skill_families": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "evaluation_posture": {
            "type": "string",
            "enum": ["minimal", "required", "strict", "paired_eval", "strict_pre_protocol_review"]
          },
          "memory_posture": {
            "type": "string",
            "enum": ["none", "light_recall", "bounded_recall", "deep_recall", "bounded_chronicle_candidate_only"]
          },
          "fallback_mode": {"type": "string", "enum": ["none", "handoff", "rollback", "safe_stop", "review_required"]},
          "expected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "eval_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "return_posture": {
            "type": "string",
            "enum": ["artifact_anchor", "checkpoint_anchor", "review_anchor", "mixed_anchor"]
          },
          "return_anchor_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 2}
          },
          "return_reentry_modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["same_phase", "previous_phase", "router_reentry", "checkpoint_relaunch", "review_gate", "rollback_gate", "safe_stop"]
            }
          },
          "memo_recall_modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["working", "episodic", "semantic", "procedural", "lineage"]
            }
          },
          "memo_scope_default": {
            "type": "string",
            "enum": ["project", "workspace", "ecosystem"]
          },
          "memo_scope_ceiling": {
            "type": "string",
            "enum": ["project", "workspace", "ecosystem"]
          },
          "memo_read_path": {
            "type": "string",
            "enum": ["inspect_only", "inspect_then_expand", "inspect_capsule_then_expand"]
          },
          "memo_checkpoint_posture": {
            "type": "string",
            "enum": ["not_needed", "preferred", "required"]
          },
          "memo_source_route_policy": {
            "type": "string",
            "enum": ["not_needed", "preferred", "required"]
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["return_posture"]
            },
            "then": {
              "required": ["return_anchor_artifacts", "return_reentry_modes"]
            }
          },
          {
            "if": {
              "required": ["return_anchor_artifacts"]
            },
            "then": {
              "required": ["return_posture"]
            }
          },
          {
            "if": {
              "required": ["return_reentry_modes"]
            },
            "then": {
              "required": ["return_posture"]
            }
          }
        ]
      }
    }
  }
}
